# Copie este arquivo para .env (o .env NÃO vai para o Git).
#   Linux/Mac/WSL: cp .env.example .env
#   PowerShell:    Copy-Item .env.example .env

# Banco (lido pelo container do Postgres e pelo Django)
POSTGRES_DB=basquete
POSTGRES_USER=basquete
POSTGRES_PASSWORD=basquete_dev

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Cadastro do treinador: defina um codigo privado no .env
# COACH_ACTIVATION_CODE=configure-um-codigo-privado-no-env

# Versao dos Termos de Uso vigentes (US63/RN15). Ao alterar, todos os usuarios
# precisam aceitar a nova versao.
TERMOS_VERSAO_ATUAL=1.0
# URLs dos documentos oficiais (http(s)://... ou caminho iniciado por /).
# Sem as duas, o cadastro (aluno/treinador) e POST /api/auth/aceitar-termos/
# respondem 503 TERMOS_INDISPONIVEIS. Ficam vazias aqui porque os documentos
# oficiais ainda não estão publicados; não aponte para páginas inexistentes em produção.
# O front consome estes valores por GET /api/auth/termos/vigentes/ (fonte única).
# Apenas para desenvolvimento local:
#   TERMOS_USO_URL=/termos-de-uso
#   POLITICA_PRIVACIDADE_URL=/politica-de-privacidade
TERMOS_USO_URL=
POLITICA_PRIVACIDADE_URL=

# Só ative se o hot reload do front não funcionar (Windows fora do WSL)
CHOKIDAR_USEPOLLING=false

# Recuperação de senha (US10 / RF1110)
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT_SECONDS=3600
PASSWORD_RESET_EMAIL_LIMIT=5
PASSWORD_RESET_IP_LIMIT=20
PASSWORD_RESET_WINDOW_SECONDS=900
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@spacejam.local