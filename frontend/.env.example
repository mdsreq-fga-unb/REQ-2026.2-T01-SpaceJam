# Variáveis VITE_ são públicas no navegador. Não inclua senhas ou tokens.
VITE_API_URL=/api
# Usado apenas pelo proxy de desenvolvimento do Vite.
VITE_PROXY_TARGET=http://localhost:8000
# URLs dos documentos oficiais; sem ambos, o aceite permanece indisponível.
VITE_TERMOS_USO_URL=
VITE_POLITICA_PRIVACIDADE_URL=
